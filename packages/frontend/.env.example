# Frontend env — vite 自动读取 .env
# 复制为 .env 后填值; wrangler pages 部署时在 Pages dashboard 设 env var
#
# PUBLIC_WS_URL: 浏览器 WebSocket 连接地址
#   dev (bun run dev):         ws://localhost:8787/ws
#   prod (Cloudflare Pages):   wss://sol-dca-do-worker.<sub>.workers.dev/ws
#     → 在 Pages dashboard > Environment variables 设 PUBLIC_WS_URL 为 prod 值
PUBLIC_WS_URL=ws://localhost:8787/ws
